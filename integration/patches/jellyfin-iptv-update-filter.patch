+def excluded_stream_item(item, sync):
+    """Skip only explicitly excluded, unsynced paths, including Season updates."""
+    whitelist = {value.replace("Mixed:", "") for value in sync.get("Whitelist", [])}
+    path = str(item.get("Path") or "").replace("\\", "/")
+    return any(library_id not in whitelist and
+               (path == prefix.rstrip("/") or path.startswith(prefix.rstrip("/") + "/"))
+               for prefix, library_id in sync.get("ExcludedLibraryPaths", {}).items())
+

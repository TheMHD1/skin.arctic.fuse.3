 logger = get_logger()
 
 
+def _wait_for_stream_capacity(fetch, shutdown_delay, *, clock=time.monotonic, sleep=gevent.sleep):
+    """Bounded admission only; never preempt a viewer or release a provider slot.
+
+    Keep the existing reconnect grace, allow two seconds of scheduling margin,
+    and cap the request budget at fifteen seconds. The final attempt happens at
+    the deadline rather than before it because a backoff would not fit.
+    """
+    budget = max(3.0, min(15.0, float(shutdown_delay) + 2.0))
+    deadline = clock() + budget
+    interval = 0.1
+    attempts = 0
+    while True:
+        attempts += 1
+        result = fetch()
+        if result[0] is not None:
+            return result, attempts
+        reason = result[5]
+        if not reason or "maximum connection limits" not in reason:
+            return result, attempts
+        remaining = deadline - clock()
+        if remaining <= 0:
+            return result, attempts
+        sleep(min(interval, remaining))
+        interval += 0.025
+
+

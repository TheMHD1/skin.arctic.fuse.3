+using System.Linq;
+using Emby.Naming.Common;
+using Emby.Naming.Video;
+using Jellyfin.Data.Enums;
+using Xunit;
+
+namespace Jellyfin.Naming.Tests.Video;
+
+public class EpisodeVersionExclusionTests
+{
+    [Theory]
+    // 12.1's confidence check now protects these chapter-number filenames upstream.
+    [InlineData("One Pace", false, 2)]
+    [InlineData("One Pace", true, 2)]
+    [InlineData("One Pace Extra", true, 2)]
+    [InlineData("Other Show", true, 2)]
+    public void ExactDirectoryOptOutPreservesSeparateEpisodes(string directory, bool enabled, int expected)
+    {
+        var options = new NamingOptions
+        {
+            EpisodeMultiVersionExcludedDirectories = enabled ? ["One Pace"] : [],
+        };
+        var paths = new[]
+        {
+            $"/data/media/shows/{directory}/Season 08/[One Pace][96-97] Loguetown 01 [480p][4200CE0D].mkv",
+            $"/data/media/shows/{directory}/Season 08/[One Pace][97] Loguetown 02 [480p][8E970FD4].mkv",
+        };
+        var files = paths.Select(path => VideoResolver.Resolve(path, false, options)).ToArray();
+        var results = new VideoListResolver(options).Resolve(files!, collectionType: CollectionType.tvshows);
+        Assert.Equal(expected, results.Count);
+        if (expected == 2)
+        {
+            Assert.All(results, item => Assert.Empty(item.AlternateVersions));
+        }
+    }
+
+    [Theory]
+    [InlineData("One Pace", true, 2)]
+    [InlineData("One Pace", false, 1)]
+    [InlineData("One Pace Extra", true, 1)]
+    [InlineData("Other Show", true, 1)]
+    public void ExplicitEpisodeVersionsStillRespectExactOptOut(string directory, bool enabled, int expected)
+    {
+        var options = new NamingOptions { EpisodeMultiVersionExcludedDirectories = enabled ? ["One Pace"] : [] };
+        var paths = new[]
+        {
+            $"/data/media/shows/{directory}/Season 01/Show.S01E01.1080p.mkv",
+            $"/data/media/shows/{directory}/Season 01/Show.S01E01.2160p.mkv",
+        };
+        var files = paths.Select(path => VideoResolver.Resolve(path, false, options)).ToArray();
+        var results = new VideoListResolver(options).Resolve(files!, collectionType: CollectionType.tvshows);
+        Assert.Equal(expected, results.Count);
+    }
+}

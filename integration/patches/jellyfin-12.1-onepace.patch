@@ -250,6 +250,16 @@ namespace Emby.Naming.Video
 
         private string? GetEpisodeVersionKey(string path)
         {
+            // Keep the explicit local opt-out while retaining upstream's new
+            // confidence checks for every other library.
+            var directories = Path.GetDirectoryName(path)?.Split(
+                new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries) ?? [];
+            if (directories.Any(directory => _namingOptions.EpisodeMultiVersionExcludedDirectories
+                .Contains(directory, StringComparer.Ordinal)))
+            {
+                return null;
+            }
+
             // Optimistic expressions are guesses, so they are not consulted here: merging is destructive,
             // a file collapsed into the alternate versions of another one is no longer an episode of its own.
             var episodeResult = _episodePathParser.Parse(path, false, isOptimistic: false, fillExtendedInfo: false);

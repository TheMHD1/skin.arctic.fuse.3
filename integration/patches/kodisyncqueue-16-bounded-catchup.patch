diff --git a/Jellyfin.Plugin.KodiSyncQueue/Utils/SyncItemSelector.cs b/Jellyfin.Plugin.KodiSyncQueue/Utils/SyncItemSelector.cs
new file mode 100644
index 0000000..20ee397
--- /dev/null
+++ b/Jellyfin.Plugin.KodiSyncQueue/Utils/SyncItemSelector.cs
@@ -0,0 +1,76 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.Json;
+using System.Threading;
+using MediaBrowser.Controller.Entities;
+
+namespace Jellyfin.Plugin.KodiSyncQueue.Utils
+{
+    /// <summary>Bounded lookups and opt-in path exclusions before expensive visibility checks.</summary>
+    public static class SyncItemSelector
+    {
+        public static string[] ParseExcludedPaths(string json)
+        {
+            if (string.IsNullOrEmpty(json))
+            {
+                return Array.Empty<string>();
+            }
+
+            try
+            {
+                var paths = JsonSerializer.Deserialize<string[]>(json);
+                if (paths is null || paths.Length > 16 || paths.Any(p => string.IsNullOrWhiteSpace(p) || p.Length > 1024 || !p.StartsWith('/') || p.Trim('/').Length == 0))
+                {
+                    throw new ArgumentException("Invalid excluded path roots");
+                }
+
+                return paths.Select(p => p.Replace('\\', '/').TrimEnd('/')).Distinct(StringComparer.Ordinal).ToArray();
+            }
+            catch (JsonException exception)
+            {
+                throw new ArgumentException("Invalid excluded path roots", exception);
+            }
+        }
+
+        public static List<string> Select(
+            IEnumerable<Guid> ids,
+            Func<Guid[], IReadOnlyList<BaseItem>> load,
+            Func<BaseItem, IEnumerable<BaseItem>> translate,
+            IReadOnlyList<string> excludedPaths,
+            CancellationToken cancellationToken)
+        {
+            var result = new HashSet<string>(StringComparer.Ordinal);
+            foreach (var batch in ids.Where(id => id != Guid.Empty).Distinct().Chunk(250))
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                var byId = load(batch).ToDictionary(item => item.Id);
+                foreach (var id in batch)
+                {
+                    cancellationToken.ThrowIfCancellationRequested();
+                    if (!byId.TryGetValue(id, out var item))
+                    {
+                        continue;
+                    }
+
+                    var path = (item.Path ?? string.Empty).Replace('\\', '/');
+                    if (excludedPaths.Any(prefix => path.Equals(prefix, StringComparison.Ordinal) || path.StartsWith(prefix + "/", StringComparison.Ordinal)))
+                    {
+                        continue;
+                    }
+
+                    foreach (var visible in translate(item))
+                    {
+                        if (visible is not null)
+                        {
+                            result.Add(visible.Id.ToString("N", CultureInfo.InvariantCulture));
+                        }
+                    }
+                }
+            }
+
+            return result.ToList();
+        }
+    }
+}

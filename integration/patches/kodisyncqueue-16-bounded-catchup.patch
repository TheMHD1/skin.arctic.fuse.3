@@ -0,0 +1,82 @@
+using Jellyfin.Plugin.KodiSyncQueue.Utils;
+using MediaBrowser.Controller.Entities;
+using Xunit;
+
+public class SyncItemSelectorTests
+{
+    private static BaseItem Item(string path) => new Folder { Id = Guid.NewGuid(), Path = path };
+
+    [Fact]
+    public void BatchesAreBoundedAndKeepRequestedOrder()
+    {
+        var items = Enumerable.Range(0, 501).Select(i => Item("/media/" + i)).ToArray();
+        var sizes = new List<int>();
+        var result = SyncItemSelector.Select(items.Select(i => i.Id).Concat(new[] { items[0].Id }), batch =>
+        {
+            sizes.Add(batch.Length);
+            return items.Where(i => batch.Contains(i.Id)).Reverse().ToArray();
+        }, i => new[] { i }, Array.Empty<string>(), default);
+        Assert.Equal(new[] { 250, 250, 1 }, sizes);
+        Assert.Equal(items.Select(i => i.Id.ToString("N")), result);
+    }
+
+    [Fact]
+    public void ExclusionsUsePathBoundariesBeforeVisibility()
+    {
+        var items = new[] { Item("/iptv/movies/1"), Item("/iptv/movies"), Item("/iptv/movies-backup/1"), Item(null), Item("/normal/movie") };
+        var checkedIds = new List<Guid>();
+        var result = SyncItemSelector.Select(items.Select(i => i.Id), _ => items, i =>
+        {
+            checkedIds.Add(i.Id);
+            return new[] { i };
+        }, new[] { "/iptv/movies" }, default);
+        Assert.Equal(items.Skip(2).Select(i => i.Id), checkedIds);
+        Assert.Equal(3, result.Count);
+    }
+
+    [Fact]
+    public void MissingAndInvisibleItemsAreNotReturned()
+    {
+        var item = Item("/movie");
+        Assert.Empty(SyncItemSelector.Select(new[] { Guid.Empty, Guid.NewGuid(), item.Id }, _ => new[] { item }, _ => Array.Empty<BaseItem>(), Array.Empty<string>(), default));
+    }
+
+    [Fact]
+    public void CancellationStopsBeforeLookup()
+    {
+        using var source = new CancellationTokenSource();
+        source.Cancel();
+        Assert.Throws<OperationCanceledException>(() => SyncItemSelector.Select(new[] { Guid.NewGuid() }, _ => throw new Exception("must not load"), i => new[] { i }, Array.Empty<string>(), source.Token));
+    }
+
+    [Fact]
+    public void CancellationStopsBetweenItems()
+    {
+        using var source = new CancellationTokenSource();
+        var items = new[] { Item("/a"), Item("/b") };
+        var translated = 0;
+        Assert.Throws<OperationCanceledException>(() => SyncItemSelector.Select(items.Select(i => i.Id), _ => items, i =>
+        {
+            translated++;
+            source.Cancel();
+            return new[] { i };
+        }, Array.Empty<string>(), source.Token));
+        Assert.Equal(1, translated);
+    }
+
+    [Theory]
+    [InlineData("null")]
+    [InlineData("invalid")]
+    [InlineData("[\"/\"]")]
+    [InlineData("[null]")]
+    [InlineData("[\"relative\"]")]
+    public void InvalidPathFiltersFailClosed(string value) => Assert.Throws<ArgumentException>(() => SyncItemSelector.ParseExcludedPaths(value));
+
+    [Fact]
+    public void PathFiltersAreOptionalNormalizedAndBounded()
+    {
+        Assert.Empty(SyncItemSelector.ParseExcludedPaths(null));
+        Assert.Equal(new[] { "/iptv/movies" }, SyncItemSelector.ParseExcludedPaths("[\"/iptv/movies/\",\"/iptv/movies\"]"));
+        Assert.Throws<ArgumentException>(() => SyncItemSelector.ParseExcludedPaths(System.Text.Json.JsonSerializer.Serialize(Enumerable.Repeat("/a", 17))));
+    }
+}

diff --git a/plugin.video.kodiseerr/jellyfin_bridge.py b/plugin.video.kodiseerr/jellyfin_bridge.py
new file mode 100644
index 0000000..4ef2332
--- /dev/null
+++ b/plugin.video.kodiseerr/jellyfin_bridge.py
@@ -0,0 +1,49 @@
+"""Exact provider-ID matching and shared Jellyfin playback/favorites for Discover."""
+import json
+import sys
+import time
+from pathlib import Path
+from urllib.parse import urlencode
+import xbmc
+import xbmcgui
+import xbmcvfs
+
+def library_index():
+    home=xbmcgui.Window(10000)
+    raw=home.getProperty('Habibi.Discover.LibraryIndex')
+    revision=home.getProperty('Habibi.Home.Refresh')
+    if raw:
+        try:
+            saved=json.loads(raw)
+            if saved['revision']==revision and time.time()-saved['time']<60:
+                return saved['items']
+        except (ValueError,KeyError):pass
+    sys.path.insert(0,xbmcvfs.translatePath('special://home/addons/plugin.video.habibi.resume'))
+    from client import Client
+    auth=Path(xbmcvfs.translatePath('special://profile/addon_data/plugin.video.jellyfin/data.json'))
+    client=Client(json.loads(auth.read_text())['Servers'][0])
+    index={};start=0
+    while True:
+        page=client.get('Users/'+client.user+'/Items',Recursive='true',IncludeItemTypes='Movie,Series',
+                        Fields='ProviderIds',Limit=500,StartIndex=start)['Items']
+        for item in page:
+            ids={k.lower():str(v) for k,v in item.get('ProviderIds',{}).items() if v}
+            tmdb=ids.get('tmdb')
+            if tmdb:
+                key=('movie' if item['Type']=='Movie' else 'tv')+':'+tmdb
+                # Duplicate editions must not select a different title by fuzzy name.
+                index.setdefault(key,item)
+        if len(page)<500:break
+        start+=len(page)
+    home.setProperty('Habibi.Discover.LibraryIndex',json.dumps({'time':time.time(),'revision':revision,'items':index}))
+    return index
+
+def route(item):
+    if item['Type']=='Series':
+        return 'plugin://plugin.video.habibi.resume/?'+urlencode({'mode':'series','series':item['Id']}),True
+    return 'plugin://plugin.video.jellyfin/?'+urlencode({'mode':'play','id':item['Id']}),False
+
+def favorite_menu(item):
+    favorite=bool(item.get('UserData',{}).get('IsFavorite'))
+    path='plugin://plugin.video.habibi.resume/?'+urlencode({'mode':'setfavorite','id':item['Id'],'value':'false' if favorite else 'true'})
+    return ('Remove from Jellyfin Favorites' if favorite else 'Add to Jellyfin Favorites','RunPlugin('+path+')')

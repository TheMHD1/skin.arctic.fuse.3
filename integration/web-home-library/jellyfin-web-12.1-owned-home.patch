@@ -0,0 +1,42 @@
+import type { BaseItemDto } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto';
+import { describe, expect, it } from 'vitest';
+
+import { favoriteItems, normalizedItemId, scoreFor, topRatedItems, uniqueOwnedItems } from './ownedHomeLogic';
+
+const item = (Id: string, Type: 'Movie' | 'Series', rating?: number, favorite = false): BaseItemDto => ({
+    Id, Type, Name: Id, CommunityRating: rating, UserData: { Key: Id, IsFavorite: favorite }
+});
+
+describe('owned Home row logic', () => {
+    it('deduplicates the requested type and rejects box sets returned by Jellyfin', () => {
+        const movie = item('a', 'Movie', 8);
+        const box = { Id: 'b', Type: 'BoxSet' } as BaseItemDto;
+        expect(uniqueOwnedItems([[movie, box], [movie]], 'Movie')).toEqual([movie]);
+    });
+
+    it('uses per-user favorites from owned movies and shows only', () => {
+        expect(favoriteItems([item('A', 'Movie', 9, true), item('B', 'Movie', 9)],
+            [item('C', 'Series', 8, true)]).map(x => x.Id)).toEqual(['A', 'C']);
+    });
+
+    it('prefers valid IMDb per item and falls back to generic CommunityRating', () => {
+        const a = item('a'.repeat(32), 'Movie', 9.5);
+        const b = item('b'.repeat(32), 'Movie', 8.2);
+        const c = item('c'.repeat(32), 'Movie');
+        const ratings = { [a.Id!]: { imdb: { rating: 7.1, votes: 100 } }, [b.Id!]: { imdb: { rating: 9.1, votes: 50 } },
+            [c.Id!]: { imdb: { rating: 11, votes: 1 } } };
+        expect(scoreFor(a, ratings)?.score).toBe(7.1);
+        expect(scoreFor(c, ratings)).toBeNull();
+        expect(topRatedItems([a, b, c], ratings, 2).map(x => x.Id)).toEqual([b.Id, a.Id]);
+    });
+
+    it('never invents ratings for missing or malformed provider values', () => {
+        expect(scoreFor(item('a', 'Series'), {})).toBeNull();
+        expect(scoreFor(item('a', 'Series', 8), { a: { imdb: { rating: Number.NaN, votes: 10 } } })?.score).toBe(8);
+    });
+
+    it('normalizes hyphenated and uppercase Jellyfin IDs without accepting arbitrary text', () => {
+        expect(normalizedItemId('AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA')).toBe('a'.repeat(32));
+        expect(normalizedItemId('not-an-id')).toBeNull();
+    });
+});

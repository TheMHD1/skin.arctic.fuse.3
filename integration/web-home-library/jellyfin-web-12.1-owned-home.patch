diff --git a/src/components/homesections/sections/ownedHomeLogic.ts b/src/components/homesections/sections/ownedHomeLogic.ts
new file mode 100644
index 0000000..6585190
--- /dev/null
+++ b/src/components/homesections/sections/ownedHomeLogic.ts
@@ -0,0 +1,100 @@
+import type { BaseItemDto } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto';
+
+export type OwnedKind = 'Movie' | 'Series';
+export type RatingMap = Record<string, { imdb?: { rating?: number; votes?: number }; community?: number }>;
+
+export const OWNED_HOME_ROWS = [
+    { title: 'Recently Watched Movies', kind: 'recentMovies', sourceNote: false },
+    { title: 'Recently Watched Shows', kind: 'recentShows', sourceNote: false },
+    { title: 'Favorites', kind: 'favorites', sourceNote: false },
+    { title: 'Top Rated Movies', kind: 'topMovies', sourceNote: true },
+    { title: 'Top Rated Shows', kind: 'topShows', sourceNote: true }
+] as const;
+
+/** Leave native rows in place; bracket the complete Recently Added group. */
+export function ownedHomeAnchors(sections: string[], latest: string, nextUp: string) {
+    const firstLatest = sections.indexOf(latest);
+    if (firstLatest >= 0) {
+        return { beforeIndex: firstLatest, topRatedIndex: sections.lastIndexOf(latest) + 1 };
+    }
+    const nextUpIndex = sections.indexOf(nextUp);
+    const fallback = nextUpIndex >= 0 ? nextUpIndex + 1 : sections.length;
+    return { beforeIndex: fallback, topRatedIndex: fallback };
+}
+
+export const normalizedItemId = (id?: string | null): string | null => {
+    const normalized = (id || '').replace(/-/g, '').toLowerCase();
+    return /^[0-9a-f]{32}$/.test(normalized) ? normalized : null;
+};
+
+export const uniqueOwnedItems = (pages: BaseItemDto[][], type: OwnedKind): BaseItemDto[] => {
+    const byId = new Map<string, BaseItemDto>();
+    for (const page of pages) {
+        for (const item of page) {
+            if (item.Id && item.Type === type) byId.set(item.Id, item);
+        }
+    }
+    return [...byId.values()];
+};
+
+export const favoriteItems = (movies: BaseItemDto[], shows: BaseItemDto[]): BaseItemDto[] =>
+    [...movies, ...shows].filter(item => item.UserData?.IsFavorite === true)
+        .sort((a, b) => (a.SortName || a.Name || '').localeCompare(b.SortName || b.Name || ''));
+
+const lastPlayed = (item: BaseItemDto): number => {
+    const value = Date.parse(item.UserData?.LastPlayedDate || '');
+    return Number.isFinite(value) && value > 0 && value <= Date.now() + 5 * 60 * 1000 ? value : 0;
+};
+
+/** A partial play has a LastPlayedDate and must count; IsPlayed is irrelevant. */
+export const recentlyWatchedMovies = (recent: BaseItemDto[], owned: BaseItemDto[], limit: number): BaseItemDto[] => {
+    const permitted = new Map(owned.map(item => [normalizedItemId(item.Id), item]));
+    const latest = new Map<string, { item: BaseItemDto; when: number }>();
+    for (const item of recent) {
+        const id = normalizedItemId(item.Id);
+        const when = lastPlayed(item);
+        if (!id || item.Type !== 'Movie' || !when || !permitted.has(id)) continue;
+        if (when > (latest.get(id)?.when || 0)) {
+            latest.set(id, { item: { ...permitted.get(id)!, UserData: item.UserData }, when });
+        }
+    }
+    return [...latest.values()].sort((a, b) => b.when - a.when || (a.item.Id || '').localeCompare(b.item.Id || ''))
+        .slice(0, limit).map(entry => entry.item);
+};
+
+/** Map episode playback to already-authorized Series cards; never show an episode from another view. */
+export const recentlyWatchedShows = (episodes: BaseItemDto[], owned: BaseItemDto[], limit: number): BaseItemDto[] => {
+    const permitted = new Map(owned.map(item => [normalizedItemId(item.Id), item]));
+    const latest = new Map<string, { item: BaseItemDto; when: number }>();
+    for (const episode of episodes) {
+        const seriesId = normalizedItemId(episode.SeriesId);
+        const when = lastPlayed(episode);
+        if (!seriesId || episode.Type !== 'Episode' || !when || !permitted.has(seriesId)) continue;
+        if (when > (latest.get(seriesId)?.when || 0)) latest.set(seriesId, { item: permitted.get(seriesId)!, when });
+    }
+    return [...latest.values()].sort((a, b) => b.when - a.when || (a.item.Id || '').localeCompare(b.item.Id || ''))
+        .slice(0, limit).map(entry => entry.item);
+};
+
+export const scoreFor = (item: BaseItemDto, ratings: RatingMap): { score: number; imdb: boolean; votes: number } | null => {
+    const imdb = ratings[normalizedItemId(item.Id) || '']?.imdb;
+    if (imdb && typeof imdb.rating === 'number' && Number.isFinite(imdb.rating)
+        && imdb.rating >= 0 && imdb.rating <= 10 && typeof imdb.votes === 'number' && imdb.votes >= 1) {
+        return { score: imdb.rating, imdb: true, votes: imdb.votes };
+    }
+    const fallback = item.CommunityRating;
+    return typeof fallback === 'number' && Number.isFinite(fallback) && fallback >= 0 && fallback <= 10 ?
+        { score: fallback, imdb: false, votes: 0 } :
+        null;
+};
+
+export const topRatedItems = (items: BaseItemDto[], ratings: RatingMap, limit: number): BaseItemDto[] =>
+    items.filter(item => scoreFor(item, ratings) !== null)
+        .sort((a, b) => {
+            const left = scoreFor(a, ratings)!;
+            const right = scoreFor(b, ratings)!;
+            return right.score - left.score || Number(right.imdb) - Number(left.imdb)
+                || right.votes - left.votes || (a.Name || '').localeCompare(b.Name || '')
+                || (a.Id || '').localeCompare(b.Id || '');
+        })
+        .slice(0, limit);
diff --git a/src/components/homesections/sections/ownedHomeLogic.test.ts b/src/components/homesections/sections/ownedHomeLogic.test.ts
new file mode 100644
index 0000000..88b2b58
--- /dev/null
+++ b/src/components/homesections/sections/ownedHomeLogic.test.ts
@@ -0,0 +1,90 @@
+import type { BaseItemDto } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto';
+import { describe, expect, it } from 'vitest';
+
+import { favoriteItems, normalizedItemId, OWNED_HOME_ROWS, ownedHomeAnchors, recentlyWatchedMovies, recentlyWatchedShows, scoreFor, topRatedItems, uniqueOwnedItems } from './ownedHomeLogic';
+
+const item = (Id: string, Type: 'Movie' | 'Series', rating?: number, favorite = false): BaseItemDto => ({
+    Id, Type, Name: Id, CommunityRating: rating, UserData: { Key: Id, IsFavorite: favorite }
+});
+
+describe('owned Home row logic', () => {
+    it('puts recent viewing and favorites before Recently Added, then both Top Rated rows', () => {
+        expect(OWNED_HOME_ROWS.map(row => row.kind)).toEqual([
+            'recentMovies', 'recentShows', 'favorites', 'topMovies', 'topShows'
+        ]);
+        expect(ownedHomeAnchors(['media', 'resume', 'nextup', 'latest', 'none'], 'latest', 'nextup'))
+            .toEqual({ beforeIndex: 3, topRatedIndex: 4 });
+        expect(ownedHomeAnchors(['media', 'latest', 'latest'], 'latest', 'nextup'))
+            .toEqual({ beforeIndex: 1, topRatedIndex: 3 });
+    });
+
+    it('keeps a stable insertion point without Recently Added or Next Up', () => {
+        expect(ownedHomeAnchors(['media', 'nextup', 'none'], 'latest', 'nextup'))
+            .toEqual({ beforeIndex: 2, topRatedIndex: 2 });
+        expect(ownedHomeAnchors(['media'], 'latest', 'nextup'))
+            .toEqual({ beforeIndex: 1, topRatedIndex: 1 });
+    });
+
+    it('deduplicates the requested type and rejects box sets returned by Jellyfin', () => {
+        const movie = item('a', 'Movie', 8);
+        const box = { Id: 'b', Type: 'BoxSet' } as BaseItemDto;
+        expect(uniqueOwnedItems([[movie, box], [movie]], 'Movie')).toEqual([movie]);
+    });
+
+    it('uses per-user favorites from owned movies and shows only', () => {
+        expect(favoriteItems([item('A', 'Movie', 9, true), item('B', 'Movie', 9)],
+            [item('C', 'Series', 8, true)]).map(x => x.Id)).toEqual(['A', 'C']);
+    });
+
+    it('prefers valid IMDb per item and falls back to generic CommunityRating', () => {
+        const a = item('a'.repeat(32), 'Movie', 9.5);
+        const b = item('b'.repeat(32), 'Movie', 8.2);
+        const c = item('c'.repeat(32), 'Movie');
+        const ratings = { [a.Id!]: { imdb: { rating: 7.1, votes: 100 } }, [b.Id!]: { imdb: { rating: 9.1, votes: 50 } },
+            [c.Id!]: { imdb: { rating: 11, votes: 1 } } };
+        expect(scoreFor(a, ratings)?.score).toBe(7.1);
+        expect(scoreFor(c, ratings)).toBeNull();
+        expect(topRatedItems([a, b, c], ratings, 2).map(x => x.Id)).toEqual([b.Id, a.Id]);
+    });
+
+    it('never invents ratings for missing or malformed provider values', () => {
+        expect(scoreFor(item('a', 'Series'), {})).toBeNull();
+        expect(scoreFor(item('a', 'Series', 8), { a: { imdb: { rating: Number.NaN, votes: 10 } } })?.score).toBe(8);
+    });
+
+    it('normalizes hyphenated and uppercase Jellyfin IDs without accepting arbitrary text', () => {
+        expect(normalizedItemId('AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA')).toBe('a'.repeat(32));
+        expect(normalizedItemId('not-an-id')).toBeNull();
+    });
+
+    it('orders recent movies by actual playback, including unfinished plays, excluding unplayed and unowned', () => {
+        const older = item('a'.repeat(32), 'Movie');
+        const newer = item('b'.repeat(32), 'Movie');
+        const unowned = item('c'.repeat(32), 'Movie');
+        const watched = (movie: BaseItemDto, date: string, played = false): BaseItemDto => ({
+            ...movie, UserData: { Key: movie.Id!, LastPlayedDate: date, Played: played }
+        });
+        expect(recentlyWatchedMovies([
+            watched(older, '2026-09-20T00:00:00Z'),
+            watched(newer, '2026-09-22T00:00:00Z', false),
+            watched(unowned, '2026-09-23T00:00:00Z'),
+            watched(older, 'not-a-date')
+        ], [older, newer], 24).map(x => x.Id)).toEqual([newer.Id, older.Id]);
+    });
+
+    it('deduplicates episodes to authorized shows using the latest episode playback time', () => {
+        const first = item('a'.repeat(32), 'Series');
+        const second = item('b'.repeat(32), 'Series');
+        const episode = (id: string, series: string, date: string): BaseItemDto => ({
+            Id: id, Type: 'Episode', SeriesId: series,
+            UserData: { Key: id, LastPlayedDate: date, Played: false }
+        });
+        expect(recentlyWatchedShows([
+            episode('1'.repeat(32), first.Id!, '2026-09-18T00:00:00Z'),
+            episode('2'.repeat(32), second.Id!, '2026-09-20T00:00:00Z'),
+            episode('3'.repeat(32), first.Id!, '2026-09-22T00:00:00Z'),
+            episode('4'.repeat(32), 'c'.repeat(32), '2026-09-23T00:00:00Z'),
+            episode('5'.repeat(32), second.Id!, '')
+        ], [first, second], 24).map(x => x.Id)).toEqual([first.Id, second.Id]);
+    });
+});
diff --git a/src/components/homesections/sections/ownedLibrary.ts b/src/components/homesections/sections/ownedLibrary.ts
new file mode 100644
index 0000000..a89b038
--- /dev/null
+++ b/src/components/homesections/sections/ownedLibrary.ts
@@ -0,0 +1,241 @@
+import type { BaseItemDto } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto';
+import type { UserDto } from '@jellyfin/sdk/lib/generated-client/models/user-dto';
+import type { ApiClient } from 'jellyfin-apiclient';
+
+import { classifySearchLibraries } from 'apps/legacy/features/search/utils/libraryScopes';
+import cardBuilder from 'components/cardbuilder/cardBuilder';
+import { getPortraitShape } from 'components/cardbuilder/utils/shape';
+import ServerConnections from 'lib/jellyfin-apiclient/ServerConnections';
+
+import type { SectionContainerElement, SectionOptions } from './section';
+import { favoriteItems, normalizedItemId, OWNED_HOME_ROWS, recentlyWatchedMovies, recentlyWatchedShows, topRatedItems, uniqueOwnedItems, type OwnedKind, type RatingMap } from './ownedHomeLogic';
+
+const PAGE_SIZE = 500;
+const MAX_ITEMS_PER_KIND = 2000;
+const RECENT_PAGE_SIZE = 100;
+const MAX_RECENT_PER_VIEW = 500;
+const DISPLAY_LIMIT = 24;
+const RATINGS_BATCH_SIZE = 100;
+const RATINGS_TIMEOUT_MS = 1800;
+const RATINGS_TTL_MS = 5 * 60 * 1000;
+const ratingCache = new Map<string, { until: number; ratings: RatingMap }>();
+
+type OwnedData = { movies: BaseItemDto[]; shows: BaseItemDto[] };
+type RecentData = { movies: BaseItemDto[]; shows: BaseItemDto[] };
+type RowKind = 'favorites' | 'recentMovies' | 'recentShows' | 'topMovies' | 'topShows';
+type OwnedContainer = SectionContainerElement & { resume: (options: { refresh: boolean }) => Promise<unknown> };
+
+function withTimeout<T>(promise: Promise<T>, milliseconds: number): Promise<T> {
+    return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('Owned Home lookup timed out')), milliseconds);
+        promise.then(resolve, reject).finally(() => clearTimeout(timer));
+    });
+}
+
+async function fetchViewItems(apiClient: ApiClient, userId: string, parentId: string, kind: OwnedKind): Promise<BaseItemDto[]> {
+    const result: BaseItemDto[] = [];
+    for (let start = 0; start < MAX_ITEMS_PER_KIND; start += PAGE_SIZE) {
+        const page = await withTimeout(apiClient.getItems(userId, {
+            ParentId: parentId, Recursive: true, IncludeItemTypes: kind,
+            SortBy: 'SortName', SortOrder: 'Ascending', StartIndex: start,
+            Limit: PAGE_SIZE, Fields: 'PrimaryImageAspectRatio,ProviderIds',
+            ExcludeLocationTypes: 'Virtual'
+        }), 3500);
+        const items = page?.Items || [];
+        result.push(...items);
+        if (typeof page?.TotalRecordCount === 'number' && page.TotalRecordCount > MAX_ITEMS_PER_KIND) {
+            throw new Error('Owned library exceeds bounded Home row limit');
+        }
+        if (items.length < PAGE_SIZE || start + items.length >= (page?.TotalRecordCount ?? Infinity)) break;
+    }
+    if (result.length >= MAX_ITEMS_PER_KIND) {
+        throw new Error('Owned library reached bounded Home row limit');
+    }
+    return result;
+}
+
+async function fetchKind(apiClient: ApiClient, userId: string, parents: string[], kind: OwnedKind): Promise<BaseItemDto[]> {
+    return uniqueOwnedItems(await Promise.all(parents.map(parent => fetchViewItems(apiClient, userId, parent, kind))), kind);
+}
+
+async function fetchRecentView(apiClient: ApiClient, userId: string, parentId: string, kind: 'Movie' | 'Episode'): Promise<BaseItemDto[]> {
+    const result: BaseItemDto[] = [];
+    const distinct = new Set<string>();
+    for (let start = 0; start < MAX_RECENT_PER_VIEW; start += RECENT_PAGE_SIZE) {
+        const page = await withTimeout(apiClient.getItems(userId, {
+            ParentId: parentId, Recursive: true, IncludeItemTypes: kind,
+            SortBy: 'DatePlayed', SortOrder: 'Descending', StartIndex: start,
+            Limit: RECENT_PAGE_SIZE, Fields: 'PrimaryImageAspectRatio',
+            ExcludeLocationTypes: 'Virtual'
+            // Deliberately no IsPlayed filter: in-progress playback counts.
+        }), 3500);
+        const items = page?.Items || [];
+        result.push(...items);
+        for (const item of items) {
+            const id = normalizedItemId(kind === 'Movie' ? item.Id : item.SeriesId);
+            const played = Date.parse(item.UserData?.LastPlayedDate || '');
+            if (item.Type === kind && id && Number.isFinite(played) && played > 0) distinct.add(id);
+        }
+        if (distinct.size >= DISPLAY_LIMIT || items.length < RECENT_PAGE_SIZE
+            || start + items.length >= (page?.TotalRecordCount ?? Infinity)) break;
+    }
+    return result;
+}
+
+async function fetchRatingsBatch(apiClient: ApiClient, ids: string[]): Promise<RatingMap> {
+    // The app installs abortcontroller-polyfill for older WebViews.
+    // eslint-disable-next-line compat/compat
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), RATINGS_TIMEOUT_MS);
+    try {
+        const url = apiClient.getUrl('/Habibi/LibraryExperience/Ratings', { ids: ids.join(',') });
+        const response = await fetch(url, {
+            signal: controller.signal,
+            headers: { Authorization: `MediaBrowser Token="${apiClient.accessToken()}"`, Accept: 'application/json' }
+        });
+        if (!response.ok) return {};
+        const body = await response.json();
+        const fetched = Date.parse(body?.fetchedAt || '');
+        if (!body || typeof body.items !== 'object' || !Number.isFinite(fetched)
+            || fetched > Date.now() + 5 * 60 * 1000 || Date.now() - fetched > 8 * 24 * 60 * 60 * 1000) return {};
+        const allowed = new Set(ids);
+        const ratings: RatingMap = {};
+        for (const [id, value] of Object.entries(body.items)) {
+            const normalized = normalizedItemId(id);
+            if (normalized && allowed.has(normalized) && value && typeof value === 'object') {
+                ratings[normalized] = value as RatingMap[string];
+            }
+        }
+        return ratings;
+    } catch {
+        return {}; // Optional IMDb feed: ordinary CommunityRating still works.
+    } finally {
+        clearTimeout(timeout);
+    }
+}
+
+async function fetchRatings(apiClient: ApiClient, userId: string, items: BaseItemDto[]): Promise<RatingMap> {
+    const ids = [...new Set(items.map(item => normalizedItemId(item.Id)).filter((id): id is string => !!id))]
+        .sort((a, b) => a.localeCompare(b, 'en'));
+    if (!ids.length) return {};
+    const key = `${apiClient.serverId()}:${userId}:${ids.join(',')}`;
+    const cached = ratingCache.get(key);
+    if (cached && cached.until > Date.now()) return cached.ratings;
+    const batches: string[][] = [];
+    for (let i = 0; i < ids.length; i += RATINGS_BATCH_SIZE) batches.push(ids.slice(i, i + RATINGS_BATCH_SIZE));
+    const ratings: RatingMap = {};
+    // Four concurrent requests at most; no per-card request waterfall.
+    for (let i = 0; i < batches.length; i += 4) {
+        const parts = await Promise.all(batches.slice(i, i + 4).map(batch => fetchRatingsBatch(apiClient, batch)));
+        for (const part of parts) Object.assign(ratings, part);
+    }
+    ratingCache.set(key, { until: Date.now() + RATINGS_TTL_MS, ratings });
+    while (ratingCache.size > 4) ratingCache.delete(ratingCache.keys().next().value!);
+    return ratings;
+}
+
+function sectionHtml(title: string, options: SectionOptions, showSourceNote: boolean): string {
+    const containerClass = options.enableOverflow ?
+        'itemsContainer scrollSlider focuscontainer-x' :
+        'itemsContainer padded-left padded-right vertical-wrap focuscontainer-x';
+    return `<h2 class="sectionTitle sectionTitle-cards padded-left">${title}</h2>`
+        + (showSourceNote ? '<div class="homeOwnedRatingNote padded-left">IMDb where available; otherwise library score</div>' : '')
+        + (options.enableOverflow ? '<div is="emby-scroller" class="padded-top-focusscale padded-bottom-focusscale" data-centerfocus="true">' : '')
+        + `<div is="emby-itemscontainer" class="${containerClass}" data-monitor="markfavorite"></div>`
+        + (options.enableOverflow ? '</div>' : '');
+}
+
+function cardsHtml(items: BaseItemDto[], options: SectionOptions): string {
+    return cardBuilder.getCardsHtml({
+        items, shape: getPortraitShape(options.enableOverflow), context: 'home',
+        showTitle: true, showYear: true, overlayText: false, centerText: true,
+        overlayPlayButton: true, showDetailsMenu: true, lazy: true,
+        allowBottomPadding: !options.enableOverflow, lines: 2
+    });
+}
+
+function selectRow(kind: RowKind, data: OwnedData, recent: RecentData, ratings: RatingMap): BaseItemDto[] {
+    switch (kind) {
+        case 'favorites': return favoriteItems(data.movies, data.shows).slice(0, DISPLAY_LIMIT);
+        case 'recentMovies': return recentlyWatchedMovies(recent.movies, data.movies, DISPLAY_LIMIT);
+        case 'recentShows': return recentlyWatchedShows(recent.shows, data.shows, DISPLAY_LIMIT);
+        case 'topMovies': return topRatedItems(data.movies, ratings, DISPLAY_LIMIT);
+        case 'topShows': return topRatedItems(data.shows, ratings, DISPLAY_LIMIT);
+    }
+}
+
+/** Mount slots immediately; start work only after the built-in Home resume. */
+export function mountOwnedHomeRows(
+    page: HTMLElement, before: Element | null, beforeTopRated: Element | null, apiClient: ApiClient,
+    user: UserDto, views: BaseItemDto[], options: SectionOptions
+): () => void {
+    const scopes = classifySearchLibraries(views.filter(view => {
+        const name = (view.Name || '').trim().toLocaleLowerCase('en-US');
+        return !name.startsWith('venom') && !name.startsWith('discover');
+    }));
+    if (!scopes.ownedMovies.length && !scopes.ownedShows.length) return () => undefined;
+    const containers: { element: HTMLElement; container: OwnedContainer; kind: RowKind }[] = [];
+    for (const row of OWNED_HOME_ROWS) {
+        const element = document.createElement('div');
+        element.className = 'verticalSection hide';
+        element.innerHTML = sectionHtml(row.title, options, row.sourceNote);
+        const anchor = row.kind === 'topMovies' || row.kind === 'topShows' ? beforeTopRated : before;
+        page.insertBefore(element, anchor);
+        const container = element.querySelector('.itemsContainer') as OwnedContainer | null;
+        if (container) containers.push({ element, container, kind: row.kind });
+    }
+    let inFlight: Promise<OwnedData> | null = null;
+    let recentInFlight: Promise<RecentData> | null = null;
+    let ratingsInFlight: Promise<RatingMap> | null = null;
+    const userId = user.Id || apiClient.getCurrentUserId();
+    const isCurrentAccount = () => apiClient.getCurrentUserId() === userId
+        && ServerConnections.currentApiClient()?.serverId() === apiClient.serverId();
+    const loadData = (): Promise<OwnedData> => {
+        if (!isCurrentAccount()) return Promise.reject(new Error('Jellyfin account changed'));
+        if (inFlight) return inFlight;
+        inFlight = (async () => {
+            const [movies, shows] = await Promise.all([
+                fetchKind(apiClient, userId, scopes.ownedMovies, 'Movie'),
+                fetchKind(apiClient, userId, scopes.ownedShows, 'Series')
+            ]);
+            if (!isCurrentAccount()) throw new Error('Jellyfin account changed');
+            return { movies, shows };
+        })().finally(() => { inFlight = null; });
+        return inFlight;
+    };
+    const loadRatings = (data: OwnedData): Promise<RatingMap> => {
+        if (ratingsInFlight) return ratingsInFlight;
+        ratingsInFlight = withTimeout(fetchRatings(apiClient, userId, [...data.movies, ...data.shows]), 3000)
+            .catch(() => ({}))
+            .finally(() => { ratingsInFlight = null; });
+        return ratingsInFlight;
+    };
+    const loadRecent = (): Promise<RecentData> => {
+        if (recentInFlight) return recentInFlight;
+        recentInFlight = Promise.all([
+            Promise.all(scopes.ownedMovies.map(parent => fetchRecentView(apiClient, userId, parent, 'Movie'))),
+            Promise.all(scopes.ownedShows.map(parent => fetchRecentView(apiClient, userId, parent, 'Episode')))
+        ]).then(([moviePages, showPages]) => {
+            if (!isCurrentAccount()) throw new Error('Jellyfin account changed');
+            return { movies: moviePages.flat(), shows: showPages.flat() };
+        }).finally(() => { recentInFlight = null; });
+        return recentInFlight;
+    };
+    return () => {
+        if (!page.isConnected || !isCurrentAccount()) return;
+        for (const row of containers) {
+            if (!page.contains(row.element)) continue;
+            row.container.fetchData = () => loadData().then(async data => {
+                const recent = row.kind === 'recentMovies' || row.kind === 'recentShows' ?
+                    await loadRecent() : { movies: [], shows: [] };
+                const ratings = row.kind === 'topMovies' || row.kind === 'topShows' ?
+                    await loadRatings(data) : {};
+                return { Items: isCurrentAccount() ? selectRow(row.kind, data, recent, ratings) : [] };
+            })
+                .catch(() => ({ Items: [] }));
+            row.container.getItemsHtml = items => cardsHtml(items, options);
+            row.container.parentContainer = row.element;
+            void row.container.resume({ refresh: true }).catch(() => row.element.classList.add('hide'));
+        }
+    };
+}

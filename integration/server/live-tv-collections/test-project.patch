 public sealed class CategorySnapshotBuilderTests
 {
+    [Fact]
+    public void ProviderOrderSurvivesGroupingVisibilityAndPaging()
+    {
+        var ids=Enumerable.Range(0,4).Select(_=>Guid.NewGuid()).ToArray();
+        var snapshot=CategorySnapshotBuilder.Build(new[] {
+            new IndexedChannel(ids[0],"Sports"),new IndexedChannel(ids[1],"Arabic"),
+            new IndexedChannel(ids[2],"Sports"),new IndexedChannel(ids[3],"Arab Cup")
+        },DateTimeOffset.UtcNow);
+        var view=snapshot.CreateUserView(ids.ToHashSet());
+        Assert.Equal(new[]{"Sports","Arabic","Arab Cup"},view.Categories.Select(c=>c.Name));
+        Assert.Equal(new[]{ids[0],ids[2]},view.GetPage(view.Categories[0].Id,0,50)!.Items);
+        var restricted=snapshot.CreateUserView(new HashSet<Guid>{ids[1],ids[3]});
+        Assert.Equal(new[]{"Arabic","Arab Cup"},restricted.Categories.Select(c=>c.Name));
+    }
+

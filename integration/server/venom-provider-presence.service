[Unit]
Description=Read-only daily Venom provider catalogue presence audit
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /data/config/dispatcharr/provider-presence.lock /usr/bin/docker exec dispatcharr python manage.py shell -c "exec(open('/data/venom-provider-presence-audit.py').read())"
TimeoutStartSec=3min
Nice=15
UMask=0077

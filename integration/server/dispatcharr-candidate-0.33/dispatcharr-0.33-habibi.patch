@@ -0,0 +1,95 @@
+"""XC VOD HEAD is metadata-only and must never enter stream_vod."""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from django.http import HttpResponse
+from django.test import RequestFactory, SimpleTestCase
+from rest_framework.response import Response
+
+
+class XcVodHeadMetadataTests(SimpleTestCase):
+    def setUp(self):
+        self.factory = RequestFactory()
+        self.user = MagicMock()
+        self.movie_relation = SimpleNamespace(movie=SimpleNamespace(uuid="movie-uuid"))
+        self.episode_relation = SimpleNamespace(episode=SimpleNamespace(uuid="episode-uuid"))
+
+    def _request(self, kind, method="HEAD"):
+        return getattr(self.factory, method.lower())(
+            f"/{kind}/test-user/test-password/17.mp4"
+        )
+
+    def _call(self, kind, method="HEAD"):
+        from apps.proxy.vod_proxy import views
+
+        view = views.stream_xc_movie if kind == "movie" else views.stream_xc_episode
+        return view(self._request(kind, method), "test-user", "test-password", "17", "mp4")
+
+    def _relation_patch(self, kind, relation):
+        name = "M3UMovieRelation" if kind == "movie" else "M3UEpisodeRelation"
+        model = MagicMock()
+        model.objects.select_related.return_value.filter.return_value.order_by.return_value.first.return_value = relation
+        return patch(f"apps.vod.models.{name}", model)
+
+    def _authorised(self):
+        return patch(
+            "apps.proxy.vod_proxy.views.authorize_xc_client",
+            return_value=(self.user, None),
+        )
+
+    def test_movie_head_is_authorised_metadata_without_stream_allocation(self):
+        with self._authorised(), self._relation_patch("movie", self.movie_relation), patch(
+            "apps.proxy.vod_proxy.views.stream_vod"
+        ) as stream_vod:
+            response = self._call("movie")
+
+        self.assertEqual(response.status_code, 200)
+        self.assertTrue(response.streaming)
+        self.assertEqual(response["Content-Type"], "video/mp4")
+        self.assertEqual(response["Accept-Ranges"], "bytes")
+        self.assertNotIn("Content-Length", response)
+        self.assertEqual(list(response.streaming_content), [])
+        stream_vod.assert_not_called()
+
+    def test_episode_head_is_authorised_metadata_without_stream_allocation(self):
+        with self._authorised(), self._relation_patch("episode", self.episode_relation), patch(
+            "apps.proxy.vod_proxy.views.stream_vod"
+        ) as stream_vod:
+            response = self._call("episode")
+
+        self.assertEqual(response.status_code, 200)
+        self.assertTrue(response.streaming)
+        self.assertEqual(response["Content-Type"], "video/mp4")
+        self.assertNotIn("Content-Length", response)
+        stream_vod.assert_not_called()
+
+    def test_head_preserves_authorisation_failure_without_stream(self):
+        with patch(
+            "apps.proxy.vod_proxy.views.authorize_xc_client",
+            return_value=(None, Response({"error": "Invalid credentials"}, status=401)),
+        ), patch("apps.proxy.vod_proxy.views.stream_vod") as stream_vod:
+            response = self._call("movie")
+
+        self.assertEqual(response.status_code, 401)
+        stream_vod.assert_not_called()
+
+    def test_head_preserves_missing_relation_without_stream(self):
+        with self._authorised(), self._relation_patch("episode", None), patch(
+            "apps.proxy.vod_proxy.views.stream_vod"
+        ) as stream_vod:
+            response = self._call("episode")
+
+        self.assertEqual(response.status_code, 404)
+        stream_vod.assert_not_called()
+
+    def test_get_remains_the_only_path_to_stream_vod(self):
+        with self._authorised(), self._relation_patch("movie", self.movie_relation), patch(
+            "apps.proxy.vod_proxy.views.stream_vod", return_value=HttpResponse("streamed")
+        ) as stream_vod:
+            response = self._call("movie", "GET")
+
+        self.assertEqual(response.status_code, 200)
+        stream_vod.assert_called_once()
+        self.assertEqual(stream_vod.call_args.args[1:3], ("movie", "movie-uuid"))
+        self.assertFalse(stream_vod.call_args.kwargs["check_network"])

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.LibraryExperience</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.LibraryExperience</RootNamespace>
    <Version>1.2.0.0-candidate12.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup>
    <JellyfinSourceRoot Condition="'$(JellyfinSourceRoot)' != ''">$([System.IO.Path]::GetFullPath('$(JellyfinSourceRoot)'))</JellyfinSourceRoot>
  </PropertyGroup>
  <Target Name="ValidateJellyfin124Source" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(JellyfinSourceRoot)' == '' or !Exists('$(JellyfinSourceRoot)/Jellyfin.sln')"
           Text="Set JellyfinSourceRoot to reviewed Jellyfin 12.4 source." />
    <Exec Command="git -c safe.directory=&quot;$(JellyfinSourceRoot)&quot; -C &quot;$(JellyfinSourceRoot)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_JellyfinSourceRevision" />
    </Exec>
    <Error Condition="'$(_JellyfinSourceRevision)' != '83d0d0e7f76e23e2e085c8ff67d28b772d35967d'"
           Text="JellyfinSourceRoot is not the reviewed Jellyfin 12.4 revision." />
  </Target>
  <ItemGroup>
    <Compile Include="../*.cs" />
    <None Include="../meta.json" Link="meta.json" CopyToOutputDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(JellyfinSourceRoot)/MediaBrowser.Common/MediaBrowser.Common.csproj" Private="false" />
    <ProjectReference Include="$(JellyfinSourceRoot)/MediaBrowser.Controller/MediaBrowser.Controller.csproj" Private="false" />
    <ProjectReference Include="$(JellyfinSourceRoot)/src/Jellyfin.Database/Jellyfin.Database.Implementations/Jellyfin.Database.Implementations.csproj" Private="false" />
  </ItemGroup>
</Project>

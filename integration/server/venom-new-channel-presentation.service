[Unit]
Description=Clean names and add missing artwork for newly published Venom channels
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /data/config/iptv-venom/venom-jellyfin-clean-names.py --curated --apply --limit 2000
ExecStart=/usr/bin/python3 /data/config/iptv-venom/venom-reviewed-artwork.py --apply --missing-only --limit 2000
ExecStartPost=/usr/bin/cp /data/config/iptv-venom/reviewed-artwork-applied.json /data/config/dispatcharr/venom-artwork-applied.json
ExecStartPost=/usr/bin/docker exec dispatcharr python manage.py shell -c "exec(open('/data/venom-artwork-overrides.py').read())"
TimeoutStartSec=25min
Nice=15
UMask=0077
